# Secrets — never commit. The repo is public.
.env
.env.local
.env.*.local
*.pem

# Dependencies
node_modules/
.pnp.*
.yarn/*

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Turborepo
.turbo/

# Expo
.expo/
.expo-shared/
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Vercel
.vercel/

# Testing / coverage
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Obsidian workspace state. `docs/` is a vault as well as a docs folder, and
# .obsidian/ holds per-machine UI state (open panes, window size, hotkeys) that
# would churn on every commit.
.obsidian/

# Wrangler's local secrets for apps/api. Holds the Klaviyo PRIVATE key.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Playwright output (apps/web/e2e)
test-results/
playwright-report/
blob-report/
# Playwright auth state (Vercel bypass cookie, e2e/global-setup.ts)
apps/web/e2e/.auth/
# Theme e2e: the storefront password session (apps/theme/e2e/global-setup.ts)
apps/theme/e2e/.auth/

# Lighthouse CI output (apps/web/lighthouserc.cjs)
.lighthouseci/
