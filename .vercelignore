# Vercel CLI uploads do NOT fully respect .gitignore — without this, a
# `vercel deploy` from the repo root tries to upload ~19,000 files / 584 MB,
# almost all of it node_modules, and fails the 15,000-file limit.
#
# Git-triggered deployments ignore this file (Vercel clones from GitHub and
# only ever sees tracked files), so this exists purely to make manual CLI
# deploys viable.

node_modules

# Build output — Vercel builds from source
.next
out
dist
build
.turbo
.expo

# Native projects, generated by `expo prebuild` and never deployed to Vercel
ios
android

# Local-only
coverage
*.log
.DS_Store
