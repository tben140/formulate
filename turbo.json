{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.example"],
  "globalEnv": [
    "SHOPIFY_STORE_DOMAIN",
    "SHOPIFY_STOREFRONT_TOKEN",
    "SHOPIFY_API_VERSION",
    "EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN",
    "EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN",
    "EXPO_PUBLIC_SHOPIFY_API_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // VERCEL is part of the cache key so a build produced locally is never
      // reused for a Vercel build, where the environment genuinely differs.
      "env": ["VERCEL"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".vercel/output/**",
        "dist/**",
        "theme.css"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // Only packages/shopify has tests today. The task is declared here rather
    // than waiting for a second one, so `turbo test` is the command from the
    // start and CI never has to change shape when tests spread.
    "test": {
      "dependsOn": ["^build"]
    },
    "codegen": {
      "cache": false
    }
  }
}
