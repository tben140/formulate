{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.example"],
  "globalEnv": [
    "SHOPIFY_STORE_DOMAIN",
    "SHOPIFY_STOREFRONT_TOKEN",
    "SHOPIFY_API_VERSION",
    "EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN",
    "EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN",
    "EXPO_PUBLIC_SHOPIFY_API_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "theme.css"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "codegen": {
      "cache": false
    }
  }
}
