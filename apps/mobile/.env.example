# apps/mobile: copy to apps/mobile/.env.local and fill in. That file is
# gitignored, and this repository is public: never commit a real value.
#
# ⚠️ EXPO_PUBLIC_* is compiled into the app bundle and ships to every device.
# Everything in this file is public by design; nothing secret may be added.
#
# Tiers: local values go here. EAS builds take theirs from EAS environment
# variables (development / preview / production), plus the non-secret values
# pinned per profile in eas.json. See "Environments and secrets" in the root
# AGENTS.md.

# --- Shopify Storefront API ---
# The Storefront *public* access token is meant for client code: scoped to
# storefront reads and rate limited per buyer IP. An Admin API token is not,
# and must never appear here.
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-04

# --- Klaviyo ---
# The PUBLIC site key, for the SDK's events.
EXPO_PUBLIC_KLAVIYO_PUBLIC_KEY=
# Base URL of apps/api, the worker that subscribes an address to the list with
# the private key the app must never hold (ADR 0007). No trailing slash. Local:
# the URL `pnpm --filter @formulate/api dev` prints.
EXPO_PUBLIC_API_BASE_URL=

# --- Web links (SHO-63) ---
# The web storefront's origin, e.g. https://your-app.vercel.app. Shared links
# point here, and Android App Links are declared for its host. Leave empty
# and the Share button hides. No trailing slash.
EXPO_PUBLIC_WEB_URL=

# --- Shopify Customer Account API (SHO-70, public by design) ---
# Customer sign-in. Neither is a credential: the shop id is in the store's
# public /.well-known/openid-configuration, and the client id is on every
# sign-in URL. A PUBLIC client, so there is no secret, and none belongs here.
# The shop id also names the sign-in callback scheme in app.config.ts
# (shop.<id>.app://callback), which must be registered on the client in
# Shopify admin. Leave empty and the Account tab says sign-in isn't set up.
# ⚠️ Expo Go can't receive that scheme: sign-in needs a development build.
EXPO_PUBLIC_SHOPIFY_SHOP_ID=
EXPO_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# --- Recharge subscription portal (SHO-71, public by design) ---
# A Recharge API token of type **Storefront** (starts strfnt_), which Recharge
# designs for client code: it can only exchange a signed-in customer's own
# token for a session scoped to that customer. Never the Recharge Admin API
# token. Leave empty and Subscriptions says they can't be shown yet.
EXPO_PUBLIC_RECHARGE_STOREFRONT_TOKEN=
