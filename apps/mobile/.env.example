# apps/mobile: copy to apps/mobile/.env.local and fill in. That file is
# gitignored, and this repository is public: never commit a real value.
#
# ⚠️ EXPO_PUBLIC_* is compiled into the app bundle and ships to every device.
# Everything in this file is public by design; nothing secret may be added.
#
# Tiers: local values go here. EAS builds take theirs from EAS environment
# variables (development / preview / production), plus the non-secret values
# pinned per profile in eas.json. See "Environments and secrets" in the root
# AGENTS.md.

# --- Shopify Storefront API ---
# The Storefront *public* access token is meant for client code: scoped to
# storefront reads and rate limited per buyer IP. An Admin API token is not,
# and must never appear here.
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-04

# --- Klaviyo ---
# The PUBLIC site key, for the SDK's events.
EXPO_PUBLIC_KLAVIYO_PUBLIC_KEY=
# Base URL of apps/api, the worker that subscribes an address to the list with
# the private key the app must never hold (ADR 0007). No trailing slash. Local:
# the URL `pnpm --filter @formulate/api dev` prints.
EXPO_PUBLIC_API_BASE_URL=

# PostHog product analytics (SHO-87). The project's public key (starts phc_),
# EU Cloud: safe in the bundle. Nothing is sent until the shopper accepts the
# in-app analytics banner. Leave empty and no analytics run at all.
EXPO_PUBLIC_POSTHOG_KEY=
