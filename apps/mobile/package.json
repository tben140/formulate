{
  "name": "@formulate/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform ios --output-dir dist",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@formulate/analytics": "workspace:*",
    "@formulate/shopify": "workspace:*",
    "@formulate/tokens": "workspace:*",
    "@shopify/checkout-sheet-kit": "3.8.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "^57.0.4",
    "expo-status-bar": "~57.0.1",
    "klaviyo-react-native-sdk": "^2.4.1",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.2"
