{
  "name": "@formulate/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform ios --output-dir dist",
    "test:e2e": "playwright test",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@formulate/analytics": "workspace:*",
    "@formulate/recharge": "workspace:*",
    "@formulate/shopify": "workspace:*",
    "@formulate/tokens": "workspace:*",
    "@shopify/checkout-sheet-kit": "3.9.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "^58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "klaviyo-react-native-sdk": "^2.4.1",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@formulate/eslint-config": "workspace:*",
    "@formulate/typescript-config": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "1.63.0",
    "@react-native/jest-preset": "~0.88.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react-native": "~14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/**/*.test.ts?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/dist/"
    ],
    "testTimeout": 15000,
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|htmlparser2|entities|domhandler|domutils|dom-serializer|domelementtype))"
    ]
  }
}
