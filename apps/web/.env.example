# apps/web: copy to apps/web/.env.local and fill in. That file is gitignored,
# and this repository is public: never commit a real value.
#
# ⚠️ Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and
# ships to every visitor. Only values that are public by design may carry it.
#
# Tiers: local values go here. Preview and production values live in the
# Vercel project's Environment Variables, one set per environment. See
# "Environments and secrets" in the root AGENTS.md.

# --- Shopify Storefront API (server-only) ---
# Not NEXT_PUBLIC_: every query runs in a Server Component, so the token never
# needs to reach the browser. packages/shopify's smoke test reads this file too.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-04

# --- Klaviyo onsite (public by design) ---
# The PUBLIC six-character site key, and the LIST (never a segment) that the
# email capture subscribes to. Both are designed to ship in client code: a key
# that can only write events for one account, and a list id that names a
# destination, not a permission. A Klaviyo PRIVATE key must never appear here.
# Leave both empty to render the site without Klaviyo.
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
NEXT_PUBLIC_KLAVIYO_LIST_ID=

# --- App links (optional, public) ---
# The app's signing certificate SHA-256 (from `eas credentials`, once EAS is
# set up) and the Apple Team ID. Served in /.well-known/assetlinks.json and
# /.well-known/apple-app-site-association; each is a 404 until set. Neither is
# secret: both files are public by design.
ANDROID_CERT_SHA256=
APPLE_TEAM_ID=

# --- Shopify Customer Account API (server-only, not secret) ---
# Customer sign-in and order history (SHO-70). From Shopify admin: Sales
# channels → Headless → your storefront → Customer Account API. Neither value
# is a credential: the client id is on every sign-in URL, and the shop id is in
# the store's public /.well-known/openid-configuration. They're server-only
# because nothing in the browser needs them. This is a PUBLIC client, so there
# is no client secret, and none belongs here.
# Leave empty and /account says sign-in isn't available.
# ⚠️ Sign-in only works over HTTPS on an origin registered as a callback URL
# (Shopify refuses localhost). See docs/integration-customer-accounts.md.
SHOPIFY_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Optional; defaults to the Storefront API version.
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=

# --- Formulate API (server-only) ---
# The Cloudflare Worker in apps/api, e.g. https://formulate-api.<you>.workers.dev
# Account deletion (SHO-90) and the subscription portal (SHO-72) are called
# from this server with the signed-in customer's token; the browser never
# calls the Worker. Recharge credentials live in the Worker only, never here.
# Leave empty and those pages say they aren't available here yet.
FORMULATE_API_URL=
