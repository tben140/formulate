# apps/web: copy to apps/web/.env.local and fill in. That file is gitignored,
# and this repository is public: never commit a real value.
#
# ⚠️ Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and
# ships to every visitor. Only values that are public by design may carry it.
#
# Tiers: local values go here. Preview and production values live in the
# Vercel project's Environment Variables, one set per environment. See
# "Environments and secrets" in the root AGENTS.md.

# --- Shopify Storefront API (server-only) ---
# Not NEXT_PUBLIC_: every query runs in a Server Component, so the token never
# needs to reach the browser. packages/shopify's smoke test reads this file too.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-04

# --- Klaviyo onsite (public by design) ---
# The PUBLIC six-character site key, and the LIST (never a segment) that the
# email capture subscribes to. Both are designed to ship in client code: a key
# that can only write events for one account, and a list id that names a
# destination, not a permission. A Klaviyo PRIVATE key must never appear here.
# Leave both empty to render the site without Klaviyo.
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
NEXT_PUBLIC_KLAVIYO_LIST_ID=

# --- Ad-platform tags (lib/ad-pixels.ts, docs/integration-ad-pixels.md) ---
# All three ids are public by design: they appear in every page that loads the
# tags. Each tag stays off while its id is empty. Nothing loads without
# tracking consent.
# GA4 measurement id, G-XXXXXXXXXX.
NEXT_PUBLIC_GA4_ID=
# Optional: a Google Ads conversion id, AW-XXXXXXXXX.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Meta dataset (pixel) id, digits only.
NEXT_PUBLIC_META_PIXEL_ID=
# SECRET: Meta Conversions API access token (Events Manager → the dataset →
# Settings → Generate access token). Vercel only, type Sensitive. Never here.
META_CAPI_TOKEN=
# Optional, while verifying: Events Manager → Test events → the test code.
META_TEST_EVENT_CODE=
# TikTok: Events Manager → the pixel → its id (letters and digits).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# SECRET: TikTok Events API access token (Events Manager → the pixel →
# Settings → Generate access token). Vercel only, type Sensitive.
TIKTOK_EVENTS_TOKEN=
# Optional, while verifying: Events Manager → Test events → the test code.
TIKTOK_TEST_EVENT_CODE=
# Pinterest: Ads → Conversions → the tag id.
NEXT_PUBLIC_PINTEREST_TAG_ID=
# Pinterest ad account id (not secret) and SECRET Conversions token (Ads →
# Conversions → Conversions API → Generate token). Vercel only, Sensitive.
PINTEREST_AD_ACCOUNT_ID=
PINTEREST_CAPI_TOKEN=
# Optional, while verifying: "true" sends server events to Pinterest's sandbox.
PINTEREST_TEST_MODE=
# Snapchat: Ads Manager → Events Manager → the pixel id.
NEXT_PUBLIC_SNAP_PIXEL_ID=
# SECRET: Snapchat Conversions API token (Business Details → Conversions API
# tokens). Vercel only, type Sensitive.
SNAP_CAPI_TOKEN=
# Reddit: Ads → Events Manager → the pixel id. Browser tag only for now.
NEXT_PUBLIC_REDDIT_PIXEL_ID=
# Microsoft Advertising: Tools → UET tag → the tag id (digits). Browser only.
NEXT_PUBLIC_UET_TAG_ID=
