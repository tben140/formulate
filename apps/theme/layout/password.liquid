<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Tokens and fonts, as in theme.liquid: critical.css depends on both %}
    {{ 'tokens.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'fonts.css' | asset_url | stylesheet_tag }}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
