[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "wordmark",
        "label": "Wordmark",
        "info": "The brand name in the header and the footer's copyright line. Leave blank to use the store name.",
        "default": "Double Helix"
      }
    ]
  },
  {
    "name": "t:general.klaviyo",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:general.klaviyo_help"
      },
      {
        "type": "text",
        "id": "klaviyo_public_key",
        "label": "t:labels.klaviyo_public_key",
        "info": "t:info.klaviyo_public_key"
      },
      {
        "type": "text",
        "id": "klaviyo_list_id",
        "label": "t:labels.klaviyo_list_id",
        "info": "t:info.klaviyo_list_id"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "Placeholders: each link is the platform's home page until the account exists. Clear a link to hide its icon. Web and the app read packages/tokens/src/social.ts; keep them the same."
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "default": "https://www.instagram.com/"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "default": "https://www.tiktok.com/"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "default": "https://www.youtube.com/"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "default": "https://www.facebook.com/"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "default": "https://www.pinterest.com/"
      },
      {
        "type": "text",
        "id": "social_x_link",
        "label": "X",
        "default": "https://x.com/"
      }
    ]
  }
]
