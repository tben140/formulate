[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "wordmark",
        "label": "Wordmark",
        "info": "The brand name in the header and the footer's copyright line. Leave blank to use the store name.",
        "default": "Double Helix"
      }
    ]
  },
  {
    "name": "t:general.klaviyo",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:general.klaviyo_help"
      },
      {
        "type": "text",
        "id": "klaviyo_public_key",
        "label": "t:labels.klaviyo_public_key",
        "info": "t:info.klaviyo_public_key"
      },
      {
        "type": "text",
        "id": "klaviyo_list_id",
        "label": "t:labels.klaviyo_list_id",
        "info": "t:info.klaviyo_list_id"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
