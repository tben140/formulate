{% doc %}
  One product card, as the product grid lays them out (snippets/product-grid.liquid).
  A snippet of its own so the grid can render the live campaign's products
  first, in a second pass, without the markup twice.

  @param {object} product - The product.
  @param {string} image_loading - 'eager' or 'lazy'.
  @param {string} image_priority - 'high' or 'auto'.
{% enddoc %}
<li>
  <a class="product-card" href="{{ product.url }}">
    <div class="product-card__media">
      {% render 'campaign-badge', product: product %}
      {% if product.featured_image %}
        {% render 'image',
          class: 'product-card__image',
          image: product.featured_image,
          width: 600,
          height: 600,
          crop: 'center',
          loading: image_loading,
          fetchpriority: image_priority
        %}
      {% else %}
        <span class="product-card__placeholder">No image</span>
      {% endif %}
    </div>

    <h2 class="product-card__title">{{ product.title | escape }}</h2>
    {%- comment -%}
      The campaign price (SHO-169) of the cheapest variant the live campaign
      covers, as campaignCardPrice in packages/shopify: a campaign that
      covers only some variants doesn't price the others.
    {%- endcomment -%}
    {%- liquid
      assign card_normal = nil
      assign card_offer = ''
      if product.metafields.double_helix.campaign.value != blank
        for variant in product.variants
          capture covers
            render 'campaign-covers', product: product, variant: variant
          endcapture
          if covers != blank
            if card_normal == nil or variant.price < card_normal
              assign card_normal = variant.price
            endif
          endif
        endfor
        if card_normal != nil
          capture card_offer
            render 'campaign-offer-cents', campaign: product.metafields.double_helix.campaign.value, price: card_normal
          endcapture
        endif
      endif
    -%}
    <p class="product-card__price">
      {%- if card_offer != blank -%}
        {%- render 'campaign-price', normal: card_normal, offer: card_offer, badge: product.metafields.double_helix.campaign.value.badge.value -%}
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </p>
  </a>
</li>
