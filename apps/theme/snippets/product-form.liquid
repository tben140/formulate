{% comment %}
  Add to cart, with variant and selling-plan selection.

  The Liquid counterpart of apps/web's components/add-to-cart-form.tsx. Same
  rules, same layout, different mechanism — the web app resolves options to a
  variant in JavaScript, this posts a real form to /cart/add.

  Progressive enhancement is the constraint that shapes everything here:

    - The whole thing is a genuine <form method="post">. With JavaScript off it
      submits to Shopify and redirects to the cart page.
    - The option pills are radios whose selection is resolved to a variant by
      product-form.js. Without JavaScript they cannot be, so <noscript> hides
      them and reveals a plain <select name="id"> instead — one control that
      needs no scripting to work.
    - Selling plan radios are named `selling_plan`, which Shopify reads from a
      normal form post. They need no JavaScript at all.

  ⚠️ The selling-plan filter below is load-bearing. See `hasOwningApp` in
  packages/shopify: a store carries selling plan groups that no app manages,
  and this store has four of them. They add to the cart and complete at
  checkout, then never charge or ship again.
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

{% comment %} Group ids owned by an installed app. `app_id` is nil for the
  seed groups Shopify creates, which is exactly the discriminator the headless
  surfaces use via `appName`. {% endcomment %}
{% assign owned_group_ids = '' %}
{% for group in product.selling_plan_groups %}
  {% if group.app_id %}
    {% assign owned_group_ids = owned_group_ids | append: group.id | append: ',' %}
  {% endif %}
{% endfor %}

<product-form class="product-form">
  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
    <input ref="variantId" type="hidden" name="id" value="{{ current_variant.id }}">
    <input type="hidden" name="quantity" value="1">

    {% comment %} Option pills, matching apps/web. {% endcomment %}
    {% if product.has_only_default_variant == false %}
      <div ref="options" class="product-form__options">
        {% for option in product.options_with_values %}
          <fieldset class="product-form__option">
            <legend class="product-form__legend">{{ option.name }}</legend>
            <div class="product-form__values">
              {% for value in option.values %}
                {% comment %}
                  `value` is a product_option_value, and `value.variant` is the
                  variant this pill would produce with the other axes as
                  currently selected, or nil when that combination doesn't
                  exist. That is exactly web's findVariantByOptions rule, so a
                  missing combination is not "sold out", matching web.

                  Not `value.available`: that is Shopify's top-down rule, which
                  only looks at the options *before* this one.

                  product-form.js keeps this in step after the shopper changes
                  an axis.
                {% endcomment %}
                {% assign pill_sold_out = false %}
                {% if value.variant and value.variant.available == false %}
                  {% assign pill_sold_out = true %}
                {% endif %}
                <label class="product-form__pill{% if pill_sold_out %} product-form__pill--sold-out{% endif %}">
                  <input
                    ref="optionInput"
                    type="radio"
                    class="visually-hidden"
                    name="option{{ forloop.parentloop.index }}"
                    value="{{ value | escape }}"
                    data-option-position="{{ forloop.parentloop.index }}"
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  <span>{{ value }}</span>
                  {%- comment -%} Sold-out combinations stay selectable, as on web. {%- endcomment -%}
                  <span class="visually-hidden" data-sold-out-note{% unless pill_sold_out %} hidden{% endunless %}>
                    ({{- 'product.sold_out' | t | downcase -}})
                  </span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      </div>

      <noscript>
        {% comment %} Hides the pills, which cannot resolve to a variant
          without scripting, and offers a select that can. {% endcomment %}
        <style>
          .product-form__options { display: none; }
        </style>

        <p class="product-form__legend">
          <label for="variant-select">{{ 'product.variant' | t }}</label>
        </p>
        <select id="variant-select" name="id" class="product-form__select">
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              {% if variant == current_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }} — {{ variant.price | money }}
              {% unless variant.available %}({{ 'product.sold_out' | t }}){% endunless %}
            </option>
          {% endfor %}
        </select>
      </noscript>
    {% endif %}

    {% comment %}
      Purchase options, filtered to app-managed groups.

      Rendered for the current variant, which is what a no-JavaScript form
      submits against. The fieldset exists whenever any variant has a plan, and
      is hidden while the current one has none, so product-form.js can rebuild
      it for whichever variant the shopper picks (SHO-123).
    {% endcomment %}
    {% assign product_has_plans = false %}
    {% for variant in product.variants %}
      {% for allocation in variant.selling_plan_allocations %}
        {% assign group_key = allocation.selling_plan_group_id | append: ',' %}
        {% if owned_group_ids contains group_key %}
          {% assign product_has_plans = true %}
        {% endif %}
      {% endfor %}
    {% endfor %}

    {% assign has_plans = false %}
    {% for allocation in current_variant.selling_plan_allocations %}
      {% assign group_key = allocation.selling_plan_group_id | append: ',' %}
      {% if owned_group_ids contains group_key %}
        {% assign has_plans = true %}
      {% endif %}
    {% endfor %}

    {% if product_has_plans %}
      <fieldset ref="plans" class="product-form__option" {% unless has_plans %}hidden{% endunless %}>
        <legend class="product-form__legend">{{ 'product.purchase_options' | t }}</legend>
        <div
          ref="planList"
          class="product-form__plans"
          data-built-for="{{ current_variant.id }}"
          data-one-time-label="{{ 'product.one_time' | t | escape }}"
        >
          <label class="product-form__plan">
            <span>
              <input type="radio" name="selling_plan" value="" checked>
              {{ 'product.one_time' | t }}
            </span>
            <span class="product-form__plan-price">{{ current_variant.price | money }}</span>
          </label>

          {% for allocation in current_variant.selling_plan_allocations %}
            {% assign group_key = allocation.selling_plan_group_id | append: ',' %}
            {% if owned_group_ids contains group_key %}
              <label class="product-form__plan">
                <span>
                  <input
                    type="radio"
                    name="selling_plan"
                    value="{{ allocation.selling_plan.id }}"
                  >
                  {{ allocation.selling_plan.name }}
                </span>
                <span class="product-form__plan-price">{{ allocation.price | money }}</span>
              </label>
            {% endif %}
          {% endfor %}
        </div>
        {% comment %}
          The subscriber gift (SHO-156). Off until the gift is really added to
          orders; switched on in the theme editor (Subscriptions). Web and the
          app read SUBSCRIBER_GIFT in packages/shopify: change together.
        {% endcomment %}
        {% if settings.subscriber_gift_enabled %}
          <p class="product-form__gift">{{ 'product.subscriber_gift' | t }}</p>
        {% endif %}
      </fieldset>
    {% endif %}

    <p ref="price" class="product-form__price">{{ current_variant.price | money }}</p>

    {% comment %}
      The button's three states are passed as data attributes rather than
      hard-coded in product-form.js, so they stay translatable — the script
      has no access to Liquid's `t` filter.
    {% endcomment %}
    <button
      ref="submit"
      type="submit"
      class="product-form__submit"
      data-add-label="{{ 'product.add_to_cart' | t | escape }}"
      data-sold-out-label="{{ 'product.sold_out' | t | escape }}"
      data-unavailable-label="{{ 'product.unavailable' | t | escape }}"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      {% if current_variant.available %}
        {{ 'product.add_to_cart' | t }}
      {% else %}
        {{ 'product.sold_out' | t }}
      {% endif %}
    </button>

    {% comment %} Errors and confirmations are announced, because the drawer
      opening is a visual event a screen reader does not narrate. {% endcomment %}
    <p
      ref="status"
      class="product-form__status"
      role="status"
      aria-live="polite"
      data-added-label="{{ 'product.added' | t | escape }}"
    ></p>

    {% comment %}
      Sticky add to cart on small screens (SHO-117), the counterpart of
      apps/web's StickyAddToCart. Inside this form, so its button submits the
      same variant and plan as the main one; product-form.js fills the text in
      from the same #sync that drives the main controls, so the two cannot
      drift.

      `inert` until the main button leaves the screen: out of the tab order and
      the accessibility tree while hidden. The accessible name starts with the
      visible text and adds the product, so a screen reader's list of buttons
      can tell the two apart (WCAG 2.5.3 keeps the visible words first).
    {% endcomment %}
    {%- liquid
      assign sticky_variant = ''
      unless current_variant.title == 'Default Title'
        assign sticky_variant = current_variant.title
      endunless
      if current_variant.available
        assign sticky_label = 'product.add_to_cart' | t
      else
        assign sticky_label = 'product.sold_out' | t
      endif
    -%}
    <div
      ref="stickyBar"
      class="product-form__sticky"
      data-product-title="{{ product.title | escape }}"
      inert
    >
      <p ref="stickyError" class="product-form__sticky-error" hidden></p>
      <div class="product-form__sticky-info">
        <p class="product-form__sticky-title">{{ product.title }}</p>
        <p ref="stickyDetail" class="product-form__sticky-detail">
          {%- if sticky_variant != '' %}{{ sticky_variant }} — {% endif %}{{ current_variant.price | money -}}
        </p>
      </div>
      <button
        ref="stickySubmit"
        type="submit"
        class="product-form__sticky-submit"
        aria-label="{{ sticky_label | escape }}, {{ product.title | escape }}{% if sticky_variant != '' %}, {{ sticky_variant | escape }}{% endif %}"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {{ sticky_label }}
      </button>
    </div>
  </form>
</product-form>

{% comment %} Variant data for product-form.js. A script tag of JSON rather
  than data attributes: the shape is nested, and JSON.parse of one element
  beats reading a dozen attributes. {% endcomment %}
<script type="application/json" data-product-variants>
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id | json }},
        "available": {{ variant.available | json }},
        "options": {{ variant.options | json }},
        "price": {{ variant.price | money | json }},
        "plans": [
          {%- assign first_plan = true -%}
          {%- for allocation in variant.selling_plan_allocations -%}
            {%- assign group_key = allocation.selling_plan_group_id | append: ',' -%}
            {%- if owned_group_ids contains group_key -%}
              {%- unless first_plan -%},{%- endunless -%}
              {%- assign first_plan = false -%}
              {
                "id": {{ allocation.selling_plan.id | json }},
                "name": {{ allocation.selling_plan.name | json }},
                "price": {{ allocation.price | money | json }}
              }
            {%- endif -%}
          {%- endfor -%}
        ]
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>
