{% doc %}
  Outputs the campaign price in pence for one item, or nothing (SHO-169):
  only a `percent` offer has one, and only for the purchases it reaches
  (`campaign-applies-to`): a one-time offer gives subscriptions none, a
  subscribe-first offer gives one-time purchases none. The same rule and rounding as `campaignUnitPrice` in
  packages/shopify/src/campaign-offer.ts. The caller checks the campaign is
  live and covers the variant.

  @param {object} campaign - A live `campaign` metaobject.
  @param {number} price - The normal price, in pence.
  @param {boolean} [subscription] - Whether this is a subscription price.

  @example
  {% capture offer %}{% render 'campaign-offer-cents', campaign: campaign, price: variant.price %}{% endcapture %}
{% enddoc %}
{%- liquid
  assign rules = campaign.offer_rules.value
  if rules.type == 'percent'
    assign percent = rules.percent | plus: 0
    assign whole = percent | round
    capture applies_to
      render 'campaign-applies-to', rules: rules
    endcapture
    assign applies_to = applies_to | strip
    assign reaches = true
    if subscription and applies_to == 'one_time'
      assign reaches = false
    elsif subscription != true and applies_to == 'subscriptions'
      assign reaches = false
    endif
    if percent >= 1 and percent <= 90 and whole == rules.percent and price > 0
      if reaches
        comment
          Half up, as Math.round in campaign-offer.ts.
        endcomment
        assign off = price | times: percent | plus: 50 | divided_by: 100
        echo price | minus: off
      endif
    endif
  endif
-%}
