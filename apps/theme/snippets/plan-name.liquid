{%- comment -%}
  A selling plan's name as shoppers read it: "Subscribe, every 60 days". The
  Liquid twin of planDisplayName in packages/shopify/src/subscribe-and-save.ts.

  Recharge names plans for the admin ("60 day subscription with 15%
  discount"); the interval is read from its "Order Frequency and Unit" option,
  as plan-supply-units reads it. A plan without a readable one keeps its name.

  Outputs text, escaped.

  Accepts:
  - selling_plan: {Object} the plan (allocation.selling_plan)
{%- endcomment -%}
{%- liquid
  assign days = 0
  for option in selling_plan.options
    if option.name contains 'requency'
      assign parts = option.value | downcase | replace: '-', ' ' | split: ' '
      assign count = parts.first | plus: 0
      assign unit = parts.last
      assign days = count
      if unit contains 'week'
        assign days = count | times: 7
      elsif unit contains 'month'
        assign days = count | times: 30
      endif
    endif
  endfor
  if days > 0
    echo 'product.plan_name' | t: days: days
  else
    echo selling_plan.name | escape
  endif
-%}
