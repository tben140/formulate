{% doc %}
  The theme settings that CSS needs at run time, as custom properties on
  :root (page width and margin, colours, input radius). Rendered in the head
  of every layout. Design tokens shared with web and the app come from
  assets/tokens.css instead, generated from packages/tokens.
{% enddoc %}
{% style %}
  :root {
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
