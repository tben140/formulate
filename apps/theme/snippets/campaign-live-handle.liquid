{% doc %}
  Outputs the handle of the campaign to show site-wide, or nothing (SHO-169):
  the live one ending soonest, as `activeCampaign` in packages/shopify. Look
  it up with `shop.metaobjects.campaign[handle]`.

  Shopify gives the first 50 campaigns here. Fine while old campaigns are
  deleted after they end (docs/campaigns.md, "Housekeeping").
{% enddoc %}
{%- liquid
  assign shown = ''
  assign shown_end = 0
  for campaign in shop.metaobjects.campaign.values
    capture status
      render 'campaign-status', campaign: campaign
    endcapture
    assign status = status | strip
    if status == 'active'
      assign end_s = campaign.ends_at.value | date: '%s' | plus: 0
      if shown == '' or end_s < shown_end
        assign shown = campaign.system.handle
        assign shown_end = end_s
      endif
    endif
  endfor
  echo shown
-%}
