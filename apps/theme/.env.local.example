# Copy to apps/theme/.env.local and fill in. That file is gitignored.
#
# Development stores are ALWAYS password protected — the "Restrict access to
# visitors with the password" setting in Online Store > Preferences is greyed
# out and cannot be disabled until the store moves to a paid plan or is
# transferred to a merchant. So every Shopify CLI command that renders the
# storefront (`theme dev`, `theme push`, `theme pull`) needs this.
#
# Find it in the Shopify admin: Online Store > Preferences > Restrict access.
#
# Deliberately NOT in ~/.zshrc: this belongs to one store, not to the machine,
# and keeping it here keeps it out of any synced dotfiles.

SHOPIFY_FLAG_STORE_PASSWORD=

# Saves passing --store on every command.
SHOPIFY_FLAG_STORE=your-store.myshopify.com
