{% comment %}
  A heading and formatted text, centred: an announcement, a brand line, a
  note on how subscriptions work.
{% endcomment %}

<div class="container">
  <section class="rich-text" {% if section.settings.heading != blank %}aria-labelledby="rich-text-{{ section.id }}"{% endif %}>
    {% if section.settings.heading != blank %}
      <h2 id="rich-text-{{ section.id }}" class="rich-text__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="rich-text__text">{{ section.settings.text }}</div>
    {% endif %}
  </section>
</div>

{% stylesheet %}
  .rich-text {
    max-inline-size: 42rem;
    margin: var(--spacing-12) auto 0;
    text-align: center;
  }

  .rich-text__heading {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .rich-text__text {
    margin-block-start: var(--spacing-3);
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How subscriptions work" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Choose every 30, 60 or 90 days. Each delivery is the supply you need until the next, and you can skip, pause or cancel any time from your account.</p>"
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
