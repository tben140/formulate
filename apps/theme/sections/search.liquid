{% comment %}
  Product search, matching apps/web's app/search/page.tsx (SHO-153): a labelled
  search form, products only, the same grid as collections, and the same
  Search & Discovery filter panel (snippets/collection-filters.liquid).

  `type=product` keeps pages and articles out, as the headless surfaces do.
  The URL is the one web uses (`/search?q=...&filter...`); web ignores `type`.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{%- liquid
  # Shopify hands search.terms over HTML-escaped already (a quote arrives as
  # &quot;), so it's unescaped once here, and every use escapes or encodes it
  # for its own context: otherwise a resubmitted search, a filter or a clear
  # link would search for the entity. &amp; goes last, so "&amp;quot;" stays
  # "&quot;".
  assign raw_terms = search.terms | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign encoded_terms = raw_terms | url_encode
  assign base = routes.search_url | append: '?type=product&q=' | append: encoded_terms
  assign product_only = false
  if search.types.size == 1 and search.types.first == 'product'
    assign product_only = true
  endif
-%}

{%- if search.performed and product_only == false -%}
  {%- comment -%}
    A URL without type=product (web's form, a shared link) searches pages and
    articles too, so the count and the pages would include them. Ask again for
    products only, keeping any filters.
  {%- endcomment -%}
  <script>
    (() => {
      const url = new URL(location.href);
      // Never twice: if Shopify still reports other types, show what came.
      if (url.searchParams.get("type") === "product") return;
      url.searchParams.set("type", "product");
      // Page 2 of mixed results isn't page 2 of products.
      url.searchParams.delete("page");
      location.replace(url);
    })();
  </script>
{%- endif -%}

<div class="container search-page">
  <h1 class="search-page__title">{{ 'search.title' | t }}</h1>

  <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
    <input type="hidden" name="type" value="product">
    <label class="visually-hidden" for="search-term-{{ section.id }}">{{ 'search.label' | t }}</label>
    <input
      id="search-term-{{ section.id }}"
      class="search-page__input"
      type="search"
      name="q"
      value="{{ raw_terms | escape }}"
      placeholder="{{ 'search.label' | t }}"
      autocomplete="off"
      enterkeyhint="search"
    >
    <button class="search-page__submit" type="submit">{{ 'search.submit' | t }}</button>
  </form>

  {%- if search.performed and product_only == false -%}
    {%- comment -%}
      Without JavaScript the reload above never happens, and these results
      would mix in pages and articles: counted, paginated, then filtered out.
      So nothing is listed; a link asks again for products only.
    {%- endcomment -%}
    <p class="search-page__empty">
      <a href="{{ base | escape }}">{{ 'search.show_products' | t: terms: search.terms }}</a>
    </p>
  {%- elsif search.performed -%}
    <section class="search-page__results" aria-labelledby="search-results-{{ section.id }}">
      <h2 id="search-results-{{ section.id }}" class="visually-hidden">{{ 'search.results' | t }}</h2>

      {% render 'collection-filters',
        filters: search.filters,
        action: routes.search_url,
        clear_url: base,
        count: search.results_count,
        terms: raw_terms
      %}

      {%- if search.results_count == 0 -%}
        <p class="search-page__empty">{{ 'search.no_products' | t: terms: search.terms }}</p>
      {%- else -%}
        {% paginate search.results by 24 %}
          {%- comment -%}
            Read inside paginate: outside it, search.results is the whole list,
            so every page would repeat the same products.
          {%- endcomment -%}
          {%- assign products = search.results | where: 'object_type', 'product' -%}
          {% render 'product-grid', products: products %}
          {{ paginate | default_pagination }}
        {% endpaginate %}
      {%- endif -%}
    </section>
  {%- endif -%}
</div>

{% stylesheet %}
  .search-page {
    padding-block: var(--spacing-8);
  }

  .search-page__title {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .search-page__form {
    display: flex;
    gap: var(--spacing-2);
    max-inline-size: 36rem;
    margin-block: var(--spacing-6) var(--spacing-8);
  }

  .search-page__input {
    flex: 1;
    min-inline-size: 0;
    padding: var(--spacing-2) var(--spacing-3);
    border: 1px solid var(--color-ink-400);
    border-radius: var(--radius-md);
    font: inherit;
  }

  .search-page__submit {
    padding: var(--spacing-2) var(--spacing-4);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-brand-600);
    color: var(--color-surface);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .search-page__submit:hover {
    background: var(--color-brand-700);
  }

  .search-page__empty {
    padding-block: var(--spacing-12);
    text-align: center;
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
