{% comment %}
  404 page.

  Same copy as apps/web's app/not-found.tsx, so a missing page reads the same
  on both surfaces. The one difference is the link: here it goes to
  /collections/all, which exists only in Liquid, so apps/web links to / instead.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div class="container page-section not-found">
  <h1>{{ '404.title' | t }}</h1>

  <p class="not-found__message">{{ '404.not_found' | t }}</p>

  <p>
    <a href="{{ routes.all_products_collection_url }}">
      {{ '404.back_to_shopping' | t }}
    </a>
  </p>
</div>

{% stylesheet %}
  .not-found__message {
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
