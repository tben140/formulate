{% comment %}
  404 page.

  apps/web has no custom not-found route, so there is nothing to match
  literally. This uses the shared container and design tokens so it reads as
  part of the same storefront rather than an unstyled fallback.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div class="container page-section not-found">
  <h1>{{ '404.title' | t }}</h1>

  <p class="not-found__message">{{ '404.not_found' | t }}</p>

  <p>
    <a href="{{ routes.all_products_collection_url }}">
      {{ '404.back_to_shopping' | t }}
    </a>
  </p>
</div>

{% stylesheet %}
  .not-found__message {
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
