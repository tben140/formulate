{% comment %}
  Product detail — the Liquid counterpart of apps/web's
  app/products/[handle]/page.tsx and apps/mobile's app/products/[handle].tsx.

  Add to cart, variant pickers and subscribe-and-save live in
  snippets/product-form.liquid. The static variant list the skeleton had is
  gone: it duplicated what the pickers now show, and listing every variant's
  price alongside a selection that changes the price is a contradiction.

  The gallery is progressively enhanced by <media-gallery> in
  assets/media-gallery.js. Without JavaScript the first image still renders and
  every thumbnail is a plain button, so the page remains usable.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% comment %}
  The breadcrumb goes through the first collection in the Shop menu that this
  product belongs to, the same rule as apps/web (breadcrumbCollection in
  packages/shopify/src/nav.ts), so both surfaces show the same trail.
{% endcomment %}
{% liquid
  assign crumb_collection = nil
  assign product_collection_handles = product.collections | map: 'handle'
  for link in linklists.shop.links
    if link.type == 'collection_link' and product_collection_handles contains link.object.handle
      assign crumb_collection = link.object
      break
    endif
  endfor
%}
<div class="container product-breadcrumbs">
  {% render 'breadcrumbs', current: product.title, parent: crumb_collection %}
</div>

{%- liquid
  comment
    A live campaign's imagery leads (SHO-204): the first entry in the
    product's campaign_media whose campaign is live, as campaignImages in
    packages/shopify/src/campaign-media.ts.
  endcomment
  assign campaign_images = blank
  for entry in product.metafields.double_helix.campaign_media.value
    assign entry_campaign = entry.campaign.value
    if entry_campaign == blank or entry.images.value == blank
      continue
    endif
    capture media_status
      render 'campaign-status', campaign: entry_campaign
    endcapture
    assign media_status = media_status | strip
    if media_status == 'active'
      assign campaign_images = entry.images.value
      break
    endif
  endfor
-%}
{%- liquid
  assign lead = product.featured_image
  assign gallery_size = product.images.size
  if campaign_images != blank
    assign lead = campaign_images.first.preview_image | default: campaign_images.first
    assign gallery_size = gallery_size | plus: campaign_images.size
  endif
-%}
<article class="container product">
  <media-gallery class="product__gallery">
    <div class="product__media">
      {% if lead %}
        <img
          ref="mainImage"
          class="product__image"
          src="{{ lead | image_url: width: 1200 }}"
          alt="{{ lead.alt | escape }}"
          width="{{ lead.width }}"
          height="{{ lead.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {% else %}
        <span class="product__placeholder">No image</span>
      {% endif %}
    </div>

    {% if gallery_size > 1 %}
      <div class="product__thumbnails" role="group" aria-label="Product images">
        {% for file in campaign_images %}
          {% assign image = file.preview_image | default: file %}
          <button
            ref="thumbnail"
            type="button"
            class="product__thumbnail"
            data-src="{{ image | image_url: width: 1200 }}"
            data-alt="{{ image.alt | escape }}"
            aria-label="Show image {{ forloop.index }} of {{ gallery_size }}"
          >
            <img
              src="{{ image | image_url: width: 160, height: 160, crop: 'center' }}"
              alt=""
              width="80"
              height="80"
              loading="lazy"
            >
          </button>
        {% endfor %}
        {% for image in product.images %}
          <button
            ref="thumbnail"
            type="button"
            class="product__thumbnail"
            data-src="{{ image | image_url: width: 1200 }}"
            data-alt="{{ image.alt | escape }}"
            aria-label="Show image {{ forloop.index | plus: campaign_images.size }} of {{ gallery_size }}"
          >
            <img
              src="{{ image | image_url: width: 160, height: 160, crop: 'center' }}"
              alt=""
              width="80"
              height="80"
              loading="lazy"
            >
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </media-gallery>

  <div class="product__info">
    <h1 class="product__title">{{ product.title }}</h1>

    {% render 'campaign-offer', product: product %}

    {% if product.description != blank %}
      <div class="product__description">{{ product.description }}</div>
    {% endif %}

    {% render 'product-form', product: product %}
  </div>
</article>

{% stylesheet %}
  /* Matched to apps/web's CampaignOffer. */
  .campaign-offer {
    margin-block-start: var(--spacing-4);
    padding: var(--spacing-4);
    border: 1px solid var(--color-brand-300);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    background: var(--color-brand-50);
  }

  .campaign-offer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2);
  }

  /* Not foreground-muted: on brand-50 that's 4.35:1, under AA's 4.5. */
  .campaign-offer__ends,
  .campaign-offer__perk {
    color: var(--color-foreground);
  }

  .campaign-offer__offer {
    margin-block-start: var(--spacing-2);
    font-weight: 600;
  }

  .campaign-offer__perk {
    margin-block-start: var(--spacing-1);
  }

  .campaign-offer a {
    display: inline-block;
    margin-block-start: var(--spacing-2);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* The trail sits above the product grid, in its own container, so it takes
     the top padding and leaves the gap below it to .product's own. */
  .product-breadcrumbs {
    padding-block-start: var(--spacing-8);
  }

  .product-breadcrumbs .breadcrumbs {
    margin-block-end: 0;
  }

  .product {
    display: grid;
    gap: var(--spacing-8);
    padding-block: var(--spacing-8);
  }

  @media (min-width: 48rem) {
    .product {
      grid-template-columns: 1fr 1fr;
    }
  }

  .product__media {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-muted);
  }

  .product__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
  }

  .product__thumbnails {
    display: flex;
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-3);
    flex-wrap: wrap;
  }

  .product__thumbnail {
    padding: 0;
    /* A visible resting border, not `transparent`. Product photography is
       often on a white background, so a transparent border leaves unselected
       thumbnails indistinguishable from the page and the user cannot tell
       other images exist. The border is always 2px so selection changes
       cannot shift layout. */
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    background: none;
    cursor: pointer;
    overflow: hidden;
    line-height: 0;
  }

  .product__thumbnail[aria-current='true'] {
    border-color: var(--color-brand-600);
  }

  .product__thumbnail:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .product__title {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .product__price {
    margin-block-start: var(--spacing-2);
    font-size: var(--text-xl);
  }

  .product__description {
    margin-block-start: var(--spacing-4);
    color: var(--color-foreground-muted);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
