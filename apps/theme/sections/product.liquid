{% comment %}
  Product detail — the Liquid counterpart of apps/web's
  app/products/[handle]/page.tsx and apps/mobile's app/products/[handle].tsx.

  Add to cart, variant pickers and subscribe-and-save live in
  snippets/product-form.liquid. The static variant list the skeleton had is
  gone: it duplicated what the pickers now show, and listing every variant's
  price alongside a selection that changes the price is a contradiction.

  The gallery is progressively enhanced by <media-gallery> in
  assets/media-gallery.js. Without JavaScript the first image still renders and
  every thumbnail is a plain button, so the page remains usable.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% comment %}
  The breadcrumb goes through the first collection in the Shop menu that this
  product belongs to, the same rule as apps/web (breadcrumbCollection in
  packages/shopify/src/nav.ts), so both surfaces show the same trail.
{% endcomment %}
{% liquid
  assign crumb_collection = nil
  assign product_collection_handles = product.collections | map: 'handle'
  for link in linklists.shop.links
    if link.type == 'collection_link' and product_collection_handles contains link.object.handle
      assign crumb_collection = link.object
      break
    endif
  endfor
%}
<div class="container product-breadcrumbs">
  {% render 'breadcrumbs', current: product.title, parent: crumb_collection %}
</div>

<article class="container product">
  <media-gallery class="product__gallery">
    <div class="product__media">
      {% if product.featured_image %}
        <img
          ref="mainImage"
          class="product__image"
          src="{{ product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {% else %}
        <span class="product__placeholder">No image</span>
      {% endif %}
    </div>

    {% if product.images.size > 1 %}
      <div class="product__thumbnails" role="group" aria-label="Product images">
        {% for image in product.images %}
          <button
            ref="thumbnail"
            type="button"
            class="product__thumbnail"
            data-src="{{ image | image_url: width: 1200 }}"
            data-alt="{{ image.alt | escape }}"
            aria-label="Show image {{ forloop.index }} of {{ product.images.size }}"
          >
            <img
              src="{{ image | image_url: width: 160, height: 160, crop: 'center' }}"
              alt=""
              width="80"
              height="80"
              loading="lazy"
            >
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </media-gallery>

  <div class="product__info">
    <h1 class="product__title">{{ product.title }}</h1>
    {% comment %}
      Stars link to Judge.me's review widget, added as an app block in the
      theme editor (Product page → Add block → Judge.me Reviews), whose
      element id is judgeme_product_reviews.
    {% endcomment %}
    {%- if product.metafields.reviews.rating_count.value > 0 -%}
      <a class="product__rating" href="#judgeme_product_reviews">
        {%- render 'stars', product: product, show_count: true -%}
      </a>
    {%- endif -%}

    {% comment %}
      Only the description's opening paragraph comes before the buy box; the
      rest follows it in closed sections, one per heading. On a phone the
      button was a long scroll down, below storage and allergen notes. The
      Liquid twin of descriptionSections in packages/shopify.
    {% endcomment %}
    {%- liquid
      assign description = product.description | strip
      assign summary = ''
      assign rest = description
      assign opening = description | slice: 0, 2
      if opening == '<p'
        assign summary = description | split: '</p>' | first | append: '</p>'
        assign rest = description | remove_first: summary
      endif
    -%}
    {% if summary != blank %}
      <div class="product__description">{{ summary }}</div>
    {% endif %}

    {% render 'product-form', product: product, show_express: section.settings.show_express_checkout %}

    {%- liquid
      assign chunks = rest | replace: '<h2', '<!--section--><h2' | replace: '<h3', '<!--section--><h3' | replace: '<h4', '<!--section--><h4' | split: '<!--section-->'
    -%}
    {% if rest != blank %}
      <div class="product-details">
        {% for chunk in chunks %}
          {%- liquid
            assign head = chunk | slice: 0, 3
            if head == '<h2' or head == '<h3' or head == '<h4'
              assign heading_html = chunk | split: '</h' | first
              assign title = heading_html | strip_html | strip
              assign body = chunk | remove_first: heading_html | remove_first: '</h2>' | remove_first: '</h3>' | remove_first: '</h4>'
            else
              assign title = 'product.details' | t
              assign body = chunk
            endif
          -%}
          {% if body != blank and body.size > 0 %}
            {%- assign body_text = body | strip_html | strip -%}
            {% if body_text != blank %}
              <details class="product-details__item">
                <summary class="product-details__summary">
                  <h2 class="product-details__title">{{ title }}</h2>
                  <span class="product-details__icon" aria-hidden="true">+</span>
                </summary>
                <div class="product-details__body">{{ body }}</div>
              </details>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  /* The trail sits above the product grid, in its own container, so it takes
     the top padding and leaves the gap below it to .product's own. */
  .product-breadcrumbs {
    padding-block-start: var(--spacing-8);
  }

  .product-breadcrumbs .breadcrumbs {
    margin-block-end: 0;
  }

  .product {
    display: grid;
    gap: var(--spacing-8);
    padding-block: var(--spacing-8);
  }

  @media (min-width: 48rem) {
    .product {
      grid-template-columns: 1fr 1fr;
    }
  }

  .product__media {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-muted);
  }

  .product__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
  }

  .product__thumbnails {
    display: flex;
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-3);
    flex-wrap: wrap;
  }

  .product__thumbnail {
    padding: 0;
    /* A visible resting border, not `transparent`. Product photography is
       often on a white background, so a transparent border leaves unselected
       thumbnails indistinguishable from the page and the user cannot tell
       other images exist. The border is always 2px so selection changes
       cannot shift layout. */
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    background: none;
    cursor: pointer;
    overflow: hidden;
    line-height: 0;
  }

  .product__thumbnail[aria-current='true'] {
    border-color: var(--color-brand-600);
  }

  .product__thumbnail:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .product__title {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .product__price {
    margin-block-start: var(--spacing-2);
    font-size: var(--text-xl);
  }

  .product__description {
    margin-block-start: var(--spacing-4);
    color: var(--color-foreground-muted);
  }

  .product-details {
    margin-block-start: var(--spacing-8);
    border-block: 1px solid var(--color-border);
  }

  .product-details__item + .product-details__item {
    border-block-start: 1px solid var(--color-border);
  }

  .product-details__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4);
    min-block-size: 2.75rem;
    padding-block: var(--spacing-1);
    cursor: pointer;
    list-style: none;
  }

  .product-details__summary::-webkit-details-marker {
    display: none;
  }

  .product-details__title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }

  .product-details__icon {
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-foreground-muted);
    transition: transform 150ms ease;
  }

  .product-details__item[open] .product-details__icon {
    transform: rotate(45deg);
  }

  .product-details__body {
    padding-block-end: var(--spacing-4);
    color: var(--color-foreground-muted);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_express_checkout",
      "label": "t:sections.product.settings.show_express_checkout.label",
      "info": "t:sections.product.settings.show_express_checkout.info",
      "default": true
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
