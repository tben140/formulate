{% comment %}
  A campaign's landing page (SHO-169), at /pages/campaigns/<handle>, the same
  path apps/web serves. Matches apps/web's app/pages/campaigns/[handle].

  Before the campaign it says when it starts; afterwards that it has ended.
  Shared links keep working, and nothing claims an offer that isn't running.
{% endcomment %}

{%- liquid
  assign campaign = metaobject
  capture status
    render 'campaign-status', campaign: campaign
  endcapture
  assign status = status | strip

  comment
    An email-link campaign: the page is reached from the email, after
    Shopify's /discount/<code> link has put the code on the cart. Liquid can't
    see who came that way, so the page shows on its dates to anyone with the
    URL; the single-use code is the real gate. Banners and badges never show
    it, and it's kept out of search (layout/theme.liquid).
  endcomment
  if status == 'restricted'
    assign start_s = campaign.starts_at.value | date: '%s' | plus: 0
    assign end_s = campaign.ends_at.value | date: '%s' | plus: 0
    assign now_s = 'now' | date: '%s' | plus: 0
    if settings.campaign_preview_at != blank
      assign now_s = settings.campaign_preview_at | date: '%s' | plus: 0
    endif
    if now_s < start_s
      assign status = 'upcoming'
    elsif now_s < end_s
      assign status = 'active'
    else
      assign status = 'ended'
    endif
  endif
  assign headline = campaign.headline.value | default: campaign.title.value
-%}

{% if status == 'invalid' %}
  <div class="page-section">
    <h1>{{ 'campaign.unavailable' | t }}</h1>
    <a class="campaign__link" href="{{ routes.root_url }}">{{ 'campaign.shop_the_range' | t }}</a>
  </div>
{% else %}
  <article class="campaign page-section" data-campaign-status="{{ status }}">
    {% render 'breadcrumbs', current: campaign.title.value %}
    {%- if status == 'active' -%}
      {%- comment -%} Tags the cart for the campaign report: assets/campaign-seen.js. {%- endcomment -%}
      <campaign-seen data-handle="{{ campaign.system.handle | escape }}"></campaign-seen>
    {%- endif -%}

    <header class="campaign__header">
      <div>
        <span class="campaign-badge">{{ campaign.badge.value | escape }}</span>
        <h1 class="campaign__title">{{ headline | escape }}</h1>
        <p class="campaign__when">
          {%- case status -%}
            {%- when 'upcoming' -%}
              {% render 'campaign-ends', campaign: campaign, which: 'starts' %}
            {%- when 'active' -%}
              {% render 'campaign-ends', campaign: campaign %}
            {%- else -%}
              {{ 'campaign.ended' | t }}
          {%- endcase -%}
        </p>
        {% if status == 'ended' %}
          <a class="campaign__link" href="{{ routes.root_url }}">{{ 'campaign.shop_the_range' | t }}</a>
          {% comment %} The footer's sign-up form has this id (sections/footer.liquid). {% endcomment %}
          <p class="campaign__next">{{ 'campaign.next_offer_html' | t: url: '#email-signup' }}</p>
        {% else %}
          {% comment %} The offer itself, always: `body` is optional. {% endcomment %}
          <p class="campaign__offer">{{ campaign.offer.value | escape }}</p>
          <div class="campaign__body">{{ campaign.body | metafield_tag }}</div>
          {% if campaign.subscriber_perk.value != blank %}
            <p class="campaign__perk">
              <strong>{{ 'campaign.subscribers' | t }}</strong>
              {{ campaign.subscriber_perk.value | escape }}.
            </p>
          {% endif %}
        {% endif %}
      </div>
      {% if campaign.image.value %}
        <div class="campaign__media">
          {% render 'image',
            class: 'campaign__image',
            image: campaign.image.value,
            width: 1200,
            loading: 'eager',
            fetchpriority: 'high'
          %}
        </div>
      {% endif %}
    </header>

    {% if status == 'active' and campaign.collection.value %}
      <section class="campaign__products" aria-labelledby="campaign-products">
        <h2 id="campaign-products">{{ 'campaign.in_offer' | t: badge: campaign.badge.value  }}</h2>
        {% render 'product-grid', products: campaign.collection.value.products, section_index: 2 %}
      </section>
    {% endif %}

    <section class="campaign__terms" aria-labelledby="campaign-terms">
      <h2 id="campaign-terms">{{ 'campaign.terms' | t }}</h2>
      <p>{{ campaign.terms.value | escape | newline_to_br }}</p>
    </section>
  </article>
{% endif %}

{% stylesheet %}
  .campaign__header {
    display: grid;
    gap: var(--spacing-6);
    padding-block-start: var(--spacing-4);
  }

  @media (min-width: 48rem) {
    .campaign__header {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .campaign__title {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-3xl);
    font-weight: 600;
    text-wrap: balance;
  }

  .campaign__when {
    margin-block-start: var(--spacing-2);
    color: var(--color-foreground-muted);
  }

  .campaign__offer {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .campaign__body > * + *,
  .campaign__body {
    margin-block-start: var(--spacing-3);
  }

  .campaign__perk {
    margin-block-start: var(--spacing-4);
    padding: var(--spacing-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
  }

  .campaign__link {
    display: inline-block;
    margin-block-start: var(--spacing-4);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .campaign__media {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
  }

  .campaign__image {
    width: 100%;
    height: auto;
  }

  .campaign__products,
  .campaign__terms {
    margin-block-start: var(--spacing-10);
  }

  .campaign__products h2 {
    margin-block-end: var(--spacing-4);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .campaign__terms {
    max-width: 48rem;
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
  }

  .campaign__terms h2 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Campaign",
  "settings": []
}
{% endschema %}
