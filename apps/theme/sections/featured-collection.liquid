{% comment %}
  Homepage product grid.

  apps/web redirects `/` straight to the default collection, so the closest
  Liquid equivalent is to render that same collection here. A redirect would
  be wrong for a theme: the homepage is a real, editable page and merchants
  expect to control it.

  Falls back to the same handle apps/web and apps/mobile use
  (DEFAULT_COLLECTION_HANDLE in packages/shopify/src/config.ts) when the
  merchant has not picked one in the theme editor.

  ⚠️ Liquid cannot import that constant, so the handle below is a copy. It has
  already drifted once: the constant moved to `best-sellers` while this still
  said `automated-collection`, and because a stale handle resolves to an empty
  collection rather than an error, the homepage silently rendered the "no
  collection selected" branch. Change both together.

  Uses the same snippet and styles as the collection template, so the two
  cannot drift.
{% endcomment %}

{% liquid
  assign featured = section.settings.collection
  unless featured
    assign featured = collections['best-sellers']
  endunless
%}

<div class="container featured">
  {% if featured != blank and featured.products.size > 0 %}
    <header class="featured__header">
      <div class="featured__heading-row">
        <h2 class="featured__title">{{ section.settings.heading | default: featured.title }}</h2>
        {% if section.settings.show_view_all %}
          <a class="featured__view-all" href="{{ featured.url }}">
            {{- 'general.view_all' | t -}}
            <span class="visually-hidden"> {{ featured.title }}</span>
          </a>
        {% endif %}
      </div>
      {% if section.settings.show_description and featured.description != blank %}
        <p class="featured__description">{{ featured.description }}</p>
      {% endif %}
    </header>

    {%- comment -%} The first few, as on web (FEATURED_COUNT): the full list is a tap away. {%- endcomment -%}
    {% render 'product-grid',
      products: featured.products,
      limit: section.settings.limit,
      section_index: section.index
    %}
  {% else %}
    <p class="featured__empty">
      No collection selected. Choose one in the theme editor.
    </p>
  {% endif %}
</div>

{% stylesheet %}
  .featured {
    padding-block: var(--spacing-8);
  }

  /* Below the home hero and benefits, so an h2 like the category cards'. */
  .featured__header {
    margin-block: var(--spacing-12) var(--spacing-6);
  }

  .featured__heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-4);
  }

  .featured__view-all {
    font-size: var(--text-sm);
    color: var(--color-brand-600);
    text-underline-offset: 4px;
  }

  .featured__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }

  .featured__description {
    margin-block-start: var(--spacing-2);
    max-width: 42rem;
    color: var(--color-foreground-muted);
  }

  .featured__empty {
    padding-block: var(--spacing-8);
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection's title."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the collection's description",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
