{% comment %}
  A banner with a heading, a line of text and one button: the quiz, a
  collection, a page. Homepage or anywhere else, from the theme editor.
{% endcomment %}

<div class="container">
  <section class="cta cta--{{ section.settings.style }}" aria-labelledby="cta-{{ section.id }}">
    <div>
      <h2 id="cta-{{ section.id }}" class="cta__heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <p class="cta__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>
    {% if section.settings.button_url != blank and section.settings.button_label != blank %}
      <a class="cta__button" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>
    {% endif %}
  </section>
</div>

{% stylesheet %}
  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-4);
    margin-block: var(--spacing-12) 0;
    padding: var(--spacing-8) var(--spacing-6);
    border-radius: var(--radius-xl);
  }

  @media (min-width: 40rem) {
    .cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-inline: var(--spacing-10);
    }
  }

  .cta--outline {
    border: 1px solid var(--color-border);
  }

  .cta--filled {
    background: var(--color-surface-muted);
  }

  .cta__heading {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .cta__text {
    max-inline-size: 36rem;
    margin: var(--spacing-2) 0 0;
    color: var(--color-foreground);
  }

  .cta__button {
    flex-shrink: 0;
    padding: var(--spacing-3) var(--spacing-6);
    border-radius: var(--radius-md);
    background: var(--color-brand-600);
    color: var(--color-surface);
    font-weight: 600;
    text-decoration: none;
  }

  .cta__button:hover {
    background: var(--color-brand-700);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Call to action",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure where to start?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Answer a few quick questions and we'll suggest a daily routine to match."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Take the quiz" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "filled", "label": "Filled" }
      ],
      "default": "outline"
    }
  ],
  "presets": [{ "name": "Call to action" }]
}
{% endschema %}
