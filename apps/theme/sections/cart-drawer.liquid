{% comment %}
  The slide-in cart, and the Liquid counterpart of apps/web's
  components/cart-drawer.tsx.

  Rendered on every page from layout/theme.liquid, and re-rendered by the
  Section Rendering API after every mutation — assets/cart-api.js asks for this
  section by id and assets/cart-drawer.js swaps in the result. That is why the
  markup lives here rather than as template strings in JavaScript: one source of
  truth for the design, and no client-side rendering to keep in step with it.

  `data-item-count` is how the header badge stays correct without a second
  request. The count arrives inside the same re-rendered HTML.
{% endcomment %}

<div
  class="cart-drawer-section"
  data-item-count="{{ cart.item_count }}"
  data-recommend-from="{{ cart.items.first.product_id }}"
  data-section-id="{{ section.id }}"
>
  <div class="cart-drawer__panel">
    <header class="cart-drawer__header">
      <h2 class="cart-drawer__title">
        {{ 'cart.title' | t }}
        {% if cart.item_count > 0 %}
          <span class="cart-drawer__count">
            {{ 'cart.item_count' | t: count: cart.item_count }}
          </span>
        {% endif %}
      </h2>

      <button ref="close" type="button" class="cart-drawer__close">
        {{ 'cart.close' | t }}
      </button>
    </header>

    {% comment %}
      Free standard delivery progress. The theme's copy of apps/web's
      <FreeShippingBar />; the logic is packages/shopify's freeShippingForCart,
      which Liquid cannot import, so it is restated here.

      Subscription items always ship free on their own delivery profile
      (SHO-99), and Shopify prices the threshold on one-time items alone, so
      only those count towards it.

      It has to be inside this section: the section is what the Section
      Rendering API re-renders, so anything outside it would render once and
      then silently stop updating.

      The same rules as the headless surfaces:
        - measured against the one-time items' line prices (after line
          discounts, before cart-level codes), never the total, which
          includes delivery
        - compared only in the threshold's own currency, and hidden otherwise
        - the sentence carries the meaning; the bar is aria-hidden decoration

      Not role="status" here. This markup is replaced wholesale on every
      change, and a live region that arrives already filled in is often not
      announced. assets/cart-drawer.js copies the sentence into a region that
      persists instead.
    {% endcomment %}
    {%- liquid
      assign free_shipping_threshold = section.settings.free_shipping_threshold | times: 100 | round
      assign free_shipping_subtotal = 0
      assign free_shipping_one_time = 0
      assign free_shipping_subscriptions = 0
      for item in cart.items
        if item.selling_plan_allocation
          assign free_shipping_subscriptions = free_shipping_subscriptions | plus: 1
        else
          assign free_shipping_one_time = free_shipping_one_time | plus: 1
          assign free_shipping_subtotal = free_shipping_subtotal | plus: item.final_line_price
        endif
      endfor
      assign show_free_shipping = false
      if cart.item_count > 0 and free_shipping_threshold > 0
        if cart.currency.iso_code == section.settings.free_shipping_currency
          assign show_free_shipping = true
        endif
      endif
    -%}
    {% if show_free_shipping %}
      {%- liquid
        if free_shipping_one_time == 0 or free_shipping_subtotal >= free_shipping_threshold
          assign free_shipping_percent = 100
        else
          assign free_shipping_percent = free_shipping_subtotal | times: 100 | divided_by: free_shipping_threshold
        endif
      -%}
      <div class="free-shipping">
        <p class="free-shipping__message" data-free-shipping-message>
          {%- if free_shipping_one_time == 0 -%}
            {{- 'cart.free_shipping.subscriptions_only' | t -}}
          {%- elsif free_shipping_subtotal >= free_shipping_threshold -%}
            {%- if free_shipping_subscriptions > 0 -%}
              {{- 'cart.free_shipping.everything' | t -}}
            {%- else -%}
              {{- 'cart.free_shipping.unlocked' | t -}}
            {%- endif -%}
          {%- else -%}
            {%- assign free_shipping_remaining = free_shipping_threshold | minus: free_shipping_subtotal | money -%}
            {%- if free_shipping_subscriptions > 0 -%}
              {{- 'cart.free_shipping.away_with_subscriptions' | t: amount: free_shipping_remaining -}}
            {%- else -%}
              {{- 'cart.free_shipping.away' | t: amount: free_shipping_remaining -}}
            {%- endif -%}
          {%- endif -%}
        </p>
        <div class="free-shipping__track" aria-hidden="true">
          <div
            class="free-shipping__fill{% if free_shipping_percent == 100 %} free-shipping__fill--unlocked{% endif %}"
            style="width: {{ free_shipping_percent }}%;"
          ></div>
        </div>
      </div>
    {% endif %}

    {% if cart.item_count == 0 %}
      <p class="cart-drawer__empty">{{ 'cart.empty' | t }}</p>
    {% else %}
      {% comment %}
        One scrolling region for the lines and the suggestions below them, so
        suggestions sit under the last line instead of pushing checkout off
        screen.
      {% endcomment %}
      <div class="cart-drawer__scroll">
      <ul class="cart-drawer__lines" role="list">
        {% for item in cart.items %}
          <li class="cart-line">
            {% if item.image %}
              <img
                class="cart-line__image"
                src="{{ item.image | image_url: width: 128, height: 128, crop: 'center' }}"
                alt=""
                width="64"
                height="64"
                loading="lazy"
              >
            {% endif %}

            <div class="cart-line__body">
              <p class="cart-line__title">{{ item.product.title }}</p>

              {% unless item.variant.title == 'Default Title' %}
                <p class="cart-line__variant">{{ item.variant.title }}</p>
              {% endunless %}

              {% comment %}
                The subscription line. This is the whole reason the selling-plan
                filter in snippets/product-form.liquid exists — it is how a
                shopper confirms they bought a subscription, not a one-off.
              {% endcomment %}
              {% if item.selling_plan_allocation %}
                <p class="cart-line__plan">
                  {{ item.selling_plan_allocation.selling_plan.name }}
                </p>
              {% endif %}

              <div class="cart-line__controls">
                {% comment %}
                  A real form posting to /cart/change. Without JavaScript this
                  submits normally and Shopify redirects back to the cart page;
                  cart-drawer.js intercepts it when JavaScript is available.
                {% endcomment %}
                <form
                  ref="quantityForm"
                  class="cart-line__quantity"
                  action="{{ routes.cart_change_url }}"
                  method="post"
                >
                  <input type="hidden" name="id" value="{{ item.key }}">
                  <label class="visually-hidden" for="qty-{{ item.key }}">
                    {{ 'cart.quantity_for' | t: title: item.product.title }}
                  </label>
                  <input
                    id="qty-{{ item.key }}"
                    class="cart-line__quantity-input"
                    type="number"
                    name="quantity"
                    value="{{ item.quantity }}"
                    min="0"
                    inputmode="numeric"
                  >
                  <button type="submit" class="cart-line__update">
                    {{ 'cart.update' | t }}
                  </button>
                </form>

                <p class="cart-line__price">{{ item.final_line_price | money }}</p>
              </div>
            </div>

            <form
              ref="removeForm"
              action="{{ routes.cart_change_url }}"
              method="post"
            >
              <input type="hidden" name="id" value="{{ item.key }}">
              <input type="hidden" name="quantity" value="0">
              <button type="submit" class="cart-line__remove">
                {{ 'cart.remove' | t }}
                <span class="visually-hidden">
                  {{ 'cart.remove_for' | t: title: item.product.title }}
                </span>
              </button>
            </form>
          </li>
        {% endfor %}
      </ul>

      {% comment %}
        Filled by assets/cart-drawer.js from sections/cart-recommendations.liquid
        (SHO-116). Empty until then, and stays empty when there is nothing to
        suggest.
      {% endcomment %}
      <div data-cart-suggestions></div>
      </div>

      <footer class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span class="cart-drawer__subtotal-value">
            {{ cart.total_price | money }}
          </span>
        </div>

        <p class="cart-drawer__note">{{ 'cart.taxes_note' | t }}</p>

        {% comment %}
          Checkout is a form submit to Shopify's own checkout, not a link — the
          Online Store expects the cart form to be posted. Unlike the headless
          surfaces there is no checkoutUrl to redirect to; the platform owns
          this handoff entirely.
        {% endcomment %}
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="cart-drawer__checkout">
            {{ 'cart.checkout' | t }}
          </button>
        </form>
      </footer>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free delivery threshold",
      "info": "Must match the price condition on the store's free delivery rate. Also set in packages/shopify/src/free-shipping.ts for web and mobile. 0 hides the bar.",
      "default": 40
    },
    {
      "type": "text",
      "id": "free_shipping_currency",
      "label": "Free delivery threshold currency",
      "info": "ISO code. The bar only shows for carts in this currency.",
      "default": "GBP"
    }
  ]
}
{% endschema %}
