{% comment %}
  "Shop by category" cards, matching apps/web's home page (SHO-61): one card
  per collection in a menu (the Shop menu unless another is chosen), in menu
  order. The collections have no images of their own, so a card falls back to
  its first product's image.
{% endcomment %}

{% liquid
  assign menu = section.settings.menu
  if menu == blank
    assign menu = linklists.shop
  endif
%}

{% if menu.links.size > 0 %}
  <div class="container">
    <section class="collection-list" aria-labelledby="collection-list-{{ section.id }}">
      <h2 id="collection-list-{{ section.id }}" class="collection-list__heading">
        {{ section.settings.heading }}
      </h2>
      <ul class="collection-list__grid" role="list">
        {% for link in menu.links %}
          {% if link.type == 'collection_link' %}
            {% assign card = link.object %}
            {% assign card_image = card.image | default: card.products.first.featured_image %}
            <li>
              <a class="collection-card" href="{{ link.url }}">
                <div class="collection-card__media">
                  {% if card_image %}
                    {{
                      card_image
                      | image_url: width: 640
                      | image_tag:
                        loading: 'lazy',
                        widths: '320, 480, 640',
                        sizes: '(min-width: 64rem) 320px, 45vw',
                        alt: ''
                    }}
                  {% endif %}
                </div>
                <div class="collection-card__body">
                  <h3 class="collection-card__title">{{ link.title }}</h3>
                  {% if card.description != blank %}
                    <p class="collection-card__description">{{ card.description | strip_html }}</p>
                  {% endif %}
                </div>
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>
  </div>
{% endif %}

{% stylesheet %}
  .collection-list {
    margin-block-start: var(--spacing-16);
  }

  .collection-list__heading {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .collection-list__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-4);
    margin: var(--spacing-6) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .collection-list__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .collection-card {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .collection-card:hover {
    border-color: var(--color-brand-400);
  }

  .collection-card__media {
    aspect-ratio: 4 / 3;
    background: var(--color-surface-muted);
  }

  .collection-card__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .collection-card__body {
    padding: var(--spacing-4);
  }

  .collection-card__title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 500;
  }

  .collection-card__description {
    display: -webkit-box;
    margin: var(--spacing-1) 0 0;
    overflow: hidden;
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "Collections from this menu, in its order. Defaults to the Shop menu."
    }
  ],
  "presets": [{ "name": "Collection list" }]
}
{% endschema %}
