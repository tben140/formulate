{% comment %}
  The homepage introduction, matching the top of apps/web's app/page.tsx
  (SHO-61). The copy is editable in the theme editor. The button goes to the
  first collection in the Shop menu, as it does on web, unless the merchant
  sets a link.

  When there are hero slides it shows them instead (SHO-203): live campaigns
  first (badge, headline, offer, the real end time and a way in), then the
  shop's `hero_slide`s, as apps/web's HeroSlider. It goes back by itself
  when nothing is running. The order: snippets/hero-slide-order.liquid.
{% endcomment %}

{% liquid
  assign heading_id = 'home-intro-' | append: section.id
  capture slide_order
    render 'hero-slide-order'
  endcapture
  assign slide_order = slide_order | strip
  assign slides = slide_order | split: ','

  assign first_link = nil
  for link in linklists.shop.links
    if link.type == 'collection_link'
      assign first_link = link
      break
    endif
  endfor

  assign button_url = section.settings.button_url
  assign button_label = section.settings.button_label
  if button_url == blank and first_link
    assign button_url = first_link.url
    if button_label == blank
      assign button_label = 'general.shop_collection' | t: title: first_link.title
    endif
  endif
%}

<div class="container">
  {% if slides.size > 0 %}
  <hero-slider
    class="home-intro home-intro--campaign"
    role="region"
    aria-labelledby="home-intro-{{ section.id }}"
    {% if slides.size > 1 %}aria-roledescription="{{ 'hero.carousel' | t }}"{% endif %}
  >
    {%- for entry in slides -%}
      {%- assign kind = entry | slice: 0 -%}
      {%- assign handle = entry | remove_first: 'c:' | remove_first: 's:' -%}
      {%- if kind == 'c' -%}
        {% render 'hero-slide',
          campaign: shop.metaobjects.campaign[handle],
          index: forloop.index,
          total: slides.size,
          heading_id: heading_id
        %}
      {%- else -%}
        {% render 'hero-slide',
          slide: shop.metaobjects.hero_slide[handle],
          index: forloop.index,
          total: slides.size,
          heading_id: heading_id
        %}
      {%- endif -%}
    {%- endfor -%}
    {% if slides.size > 1 %}
      <div class="home-intro__controls" hidden data-controls>
        <button type="button" class="home-intro__control" data-play data-pause-label="{{ 'hero.pause' | t }}" data-play-label="{{ 'hero.play' | t }}">{{ 'hero.pause' | t }}</button>
        <button type="button" class="home-intro__control" data-prev>{{ 'hero.previous' | t }}</button>
        <button type="button" class="home-intro__control" data-next>{{ 'hero.next' | t }}</button>
        <span class="home-intro__dots">
          {%- for entry in slides -%}
            <button
              type="button"
              class="home-intro__dot"
              data-dot
              aria-label="{{ 'hero.show' | t: index: forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {%- endfor -%}
        </span>
      </div>
    {% endif %}
  </hero-slider>
  {% else %}
  <section class="home-intro" aria-labelledby="home-intro-{{ section.id }}">
    <h1 id="home-intro-{{ section.id }}" class="home-intro__heading">{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}
      <p class="home-intro__text">{{ section.settings.text }}</p>
    {% endif %}
    {% if button_url != blank and button_label != blank %}
      <a class="home-intro__button" href="{{ button_url }}">{{ button_label }}</a>
    {% endif %}
  </section>
  {% endif %}
</div>

{% stylesheet %}
  .home-intro {
    margin-block-start: var(--spacing-8);
    padding: var(--spacing-12) var(--spacing-6);
    border-radius: var(--radius-xl);
    background: var(--color-surface-muted);
  }

  @media (min-width: 40rem) {
    .home-intro {
      padding-inline: var(--spacing-10);
    }
  }

  .home-intro__heading {
    max-inline-size: 36rem;
    margin: 0;
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* The main text colour: muted grey on this panel is 4.34:1, under AA. */
  .home-intro__text {
    max-inline-size: 36rem;
    margin: var(--spacing-4) 0 0;
    font-size: var(--text-lg);
    color: var(--color-foreground);
  }

  .home-intro__button {
    display: inline-block;
    margin-block-start: var(--spacing-8);
    padding: var(--spacing-3) var(--spacing-6);
    border-radius: var(--radius-md);
    background: var(--color-brand-600);
    color: var(--color-surface);
    font-weight: 600;
    text-decoration: none;
  }

  .home-intro__button:hover {
    background: var(--color-brand-700);
  }

  /* The hero slides (SHO-203), matched to apps/web's HeroSlider: brand-50,
     each slide two columns from md. Text stays foreground: muted is under AA
     on brand-50. */
  hero-slider {
    display: block;
  }

  .home-intro--campaign {
    background: var(--color-brand-50);
  }

  .home-intro__slide {
    display: grid;
    gap: var(--spacing-8);
    align-items: center;
  }

  /* display: grid would otherwise override the hidden attribute. */
  .home-intro__slide[hidden] {
    display: none;
  }

  .home-intro--campaign .home-intro__heading {
    margin-block-start: var(--spacing-3);
  }

  .home-intro--campaign .home-intro__text + .home-intro__text {
    margin-block-start: var(--spacing-2);
  }

  @media (min-width: 48rem) {
    .home-intro__slide {
      grid-template-columns: 1fr 1fr;
    }
  }

  .home-intro__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    align-items: center;
    margin-block-start: var(--spacing-8);
  }

  .home-intro__controls[hidden] {
    display: none;
  }

  .home-intro__control {
    padding: 0.375rem var(--spacing-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  .home-intro__dots {
    display: flex;
    gap: var(--spacing-2);
    margin-inline-start: auto;
  }

  .home-intro__dot {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    padding: 0;
    border: 1px solid var(--color-brand-700);
    border-radius: 9999px;
    background: var(--color-surface);
    cursor: pointer;
  }

  .home-intro__dot[aria-current="true"] {
    background: var(--color-brand-700);
  }

  .home-intro__media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home introduction",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday supplements, delivered on your schedule"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Buy once or subscribe. Subscriptions can be skipped, paused or cancelled at any time."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to use \"Shop\" and the first collection in the Shop menu."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "info": "Leave blank to link to the first collection in the Shop menu."
    }
  ],
  "presets": [{ "name": "Home introduction" }]
}
{% endschema %}
