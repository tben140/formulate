# Copy to apps/web/.env.local and apps/mobile/.env.local, then fill in.
# Both files are gitignored. This repo is public — never commit a real token.
#
# The Storefront API *public* access token is designed to be visible in client
# code: it is scoped to storefront reads and rate limited per buyer IP. The
# Admin API token is NOT, and must never appear anywhere under packages/ —
# Admin calls belong behind a Next.js route handler.

# --- apps/web/.env.local ---
# Not NEXT_PUBLIC_*: the web app fetches only in Server Components, so the
# token has no reason to reach the browser bundle.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-04

# --- apps/mobile/.env.local ---
# EXPO_PUBLIC_* is unavoidable here: the Expo bundle *is* the client, so the
# token ships with the app. That is what a public Storefront token is for.
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-04

# --- Klaviyo (both apps) ---
# The PUBLIC onsite key, six characters. Designed to ship in client code: it is
# scoped to writing events for one account and nothing else. A Klaviyo PRIVATE
# key must never appear in either app — the Expo bundle in particular ships to
# every device.
#
# The Liquid theme needs neither: its app embed injects the key server-side.
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
EXPO_PUBLIC_KLAVIYO_PUBLIC_KEY=
