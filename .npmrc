# Expo's native module resolution does not cope with pnpm's default symlinked
# store — React Native's Metro bundler and the autolinking step both expect a
# flat, real-directory node_modules. This is the single required deviation from
# pnpm defaults in an Expo monorepo.
node-linker=hoisted

# Surface peer dependency problems rather than silently installing them.
auto-install-peers=false
strict-peer-dependencies=false
